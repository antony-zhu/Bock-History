{
  "identity": {
    "siteId": "site-example",
    "blockId": "block-0001",
    "deviceId": "block-0001"
  },
  "paths": {
    "dataDir": "/var/lib/block",
    "databasePath": "/var/lib/block/block.db",
    "webRoot": "/opt/block/current/web"
  },
  "server": {
    "localHttpAddress": "127.0.0.1:8080",
    "maintenanceHttpsAddress": "0.0.0.0:8443",
    "maintenanceTlsCertificateFile": "/etc/block/certs/maintenance.crt",
    "maintenanceTlsPrivateKeyFile": "/etc/block/certs/maintenance.key",
    "wsPingInterval": "30s",
    "wsClientQueueSize": 128
  },
  "plc": {
    "scanAddressRange": "192.168.1.0/24",
    "scanWorkerLimit": 16,
    "pollInterval": "50ms",
    "ioTimeout": "500ms",
    "commandQueueSize": 64,
    "defaultPulseDuration": "100ms"
  },
  "mqtt": {
    "enabled": false,
    "scheme": "mqtts",
    "host": "bdm.example.invalid",
    "port": 8883,
    "qos": 0,
    "latestStatusInterval": "60s",
    "caFile": "/etc/block/certs/bdm-ca.crt",
    "clientCertificateFile": "/etc/block/certs/block-client.crt",
    "clientKeyFile": "/etc/block/certs/block-client.key"
  },
  "session": {
    "idleTimeout": "300s"
  },
  "ssh": {
    "username": "block",
    "port": 22,
    "authorizedKeysFile": "/home/block/.ssh/authorized_keys"
  }
}
