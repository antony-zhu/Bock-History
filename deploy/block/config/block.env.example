# This file is read by systemd before it starts the single Block runtime.
# Replace the maintenance hash and certificate paths on the device.  Do not put
# PLC points, passwords, private-key contents, or Wi-Fi settings in this file.
BLOCK_LOCAL_HTTPS_ADDRESS=127.0.0.1:8444
BLOCK_LOCAL_TLS_CERT=/etc/block/certs/maintenance.crt
BLOCK_LOCAL_TLS_KEY=/etc/block/certs/maintenance.key
# Public CA used by the kiosk and strict local health checks. It contains no private key.
BLOCK_LOCAL_TLS_CA=/etc/block/certs/maintenance-ca.crt
BLOCK_STATE_DB=/var/lib/block/block.db
BLOCK_HMI_STATIC_DIR=/opt/block/current/web

BLOCK_MAINTENANCE_HTTPS_ADDRESS=0.0.0.0:8443
BLOCK_MAINTENANCE_TLS_CERT=/etc/block/certs/maintenance.crt
BLOCK_MAINTENANCE_TLS_KEY=/etc/block/certs/maintenance.key
BLOCK_MAINTENANCE_SUPER_KEY_HASH=replace-with-device-argon2id-hash
BLOCK_MAINTENANCE_AUTHORIZED_KEYS=/home/block/.ssh/authorized_keys
BLOCK_MAINTENANCE_DEVICE_ID=block-0001
BLOCK_MAINTENANCE_ADVERTISED_HOST=block-0001.local

BLOCK_MQTTS_V2_ENABLED=false
BLOCK_MQTTS_V2_ENDPOINT=mqtts://bdm.example.invalid:8883
BLOCK_MQTTS_V2_CA=/etc/block/certs/bdm-ca.crt
BLOCK_MQTTS_V2_CLIENT_CERT=/etc/block/certs/block-client.crt
BLOCK_MQTTS_V2_CLIENT_KEY=/etc/block/certs/block-client.key
BLOCK_MQTTS_V2_PRINCIPAL=block-0001
BLOCK_MQTTS_V2_SITE_ID=site-example
BLOCK_MQTTS_V2_BLOCK_ID=block-0001
BLOCK_MQTTS_V2_DEVICE_ID=block-0001
