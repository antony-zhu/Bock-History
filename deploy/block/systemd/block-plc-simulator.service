[Unit]
Description=Block PLC simulator (lab and development only)
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=block-simulator
Group=block-simulator
SupplementaryGroups=block-sim-io block-sim-control
UMask=0077
RuntimeDirectory=block-plc
RuntimeDirectoryMode=0711
StateDirectory=block-plc-sim
StateDirectoryMode=0700
ExecStart=/opt/block/current/bin/plc-simulator -config /etc/block/plc-simulator.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/block
ReadWritePaths=/run/block-plc /var/lib/block-plc-sim
InaccessiblePaths=-/run/block-agent -/var/lib/block-agent
MemoryMax=192M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
