[Unit]
Description=Block local HMI (HTTPS loopback only)
After=local-fs.target block-agent.service
Wants=block-agent.service

[Service]
Type=simple
User=block-hmi
Group=block-hmi
SupplementaryGroups=block-hmi-api
UMask=0077
Environment=BLOCK_HMI_ADDR=127.0.0.1:8443
Environment=BLOCK_HMI_BASE_PATH=/block-apple-style
Environment=BLOCK_HMI_AGENT_SOCKET=/run/block-agent/api/block-agent.sock
Environment=BLOCK_HMI_AGENT_TIMEOUT=8s
Environment=BLOCK_HMI_TLS_CERT=/etc/block/certs/block-hmi.crt
Environment=BLOCK_HMI_TLS_KEY=/etc/block/certs/block-hmi.key
ExecStart=/opt/block/current/bin/block-hmi
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/etc/block/certs
InaccessiblePaths=-/run/block-plc -/var/lib/block-agent -/var/lib/block-plc-sim
MemoryMax=192M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
